# VideoHub — frontend (Next.js 14, Vercel)
# Copy to .env.local for local dev; set the same names in the Vercel project settings.
# All are PUBLIC (NEXT_PUBLIC_*) — exposed to the browser by design.

# Convex deployment URL (from `npx convex dev` / the Convex dashboard).
# Example: https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# GLOBAL platform apkId — the constant the player uses to unwrap the key blob
# (this is window.apkId). MUST equal the backend's APK_ID. 64 hex chars.
NEXT_PUBLIC_APK_ID=

# (Optional) Public https URL of the FastAPI backend. Not required anymore —
# the tokenized master playlist URL is returned by Convex getStreamToken. Kept
# for reference / debugging.
# NEXT_PUBLIC_BACKEND_URL=
