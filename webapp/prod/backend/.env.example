# VideoHub — backend (FastAPI, Render)
# Copy to .env for local dev; set the same names in the Render dashboard for production.

# The Convex HTTP-actions origin (the *.convex.site host, NOT *.convex.cloud).
# The backend calls {CONVEX_SITE_URL}/generateUploadUrl, /fileUrl, /getKeyMaterial,
# /getVideo, /saveVideoResult.
# Example: https://your-deployment.convex.site
CONVEX_SITE_URL=

# Shared server-to-server secret. MUST equal Convex's ADMIN_SHARED_SECRET.
# Sent/received as the X-Admin-Secret header on every server-to-server call.
ADMIN_SHARED_SECRET=

# GLOBAL platform apkId (one constant for every video/user, like Spayee's window.apkId).
# 64 hex chars; MUST equal the frontend's NEXT_PUBLIC_APK_ID. Used to wrap the key blob.
# Generate: python3 -c "import secrets;s=secrets.token_bytes(16).hex();print(s[:16]+secrets.token_bytes(16).hex()+s[16:])"
APK_ID=

# GLOBAL content IV (32 hex) shared by every video — exactly like Spayee, which used
# the same 0x496daa1c... IV in every playlist. Used at encrypt time; appears in every
# EXT-X-KEY. Default matches Spayee's value; set your own if you like.
CONTENT_IV=496daa1c6914000e408c65cead91fc29

# Allowed CORS origin — the frontend's public origin.
# Local dev: http://localhost:3000
FRONTEND_ORIGIN=

# Port the server binds to. Render injects this at runtime; set 8000 for local dev.
PORT=8000

# (Optional / unused) The service's own public URL. All stream URLs are now built by
# Convex (getStreamToken) and are relative inside playlists, so the backend needs no
# absolute self-URL. Kept for reference.
# PUBLIC_BACKEND_URL=
